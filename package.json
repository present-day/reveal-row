{
  "name": "@present-day/reveal-row",
  "version": "0.2.0",
  "description": "Horizontal scroll-to-reveal row for actions on the left, right, or both sides",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "packageManager": "bun@1.3.13",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome check .",
    "format": "biome check --write .",
    "type-check": "tsc --noEmit",
    "test": "bun --bun vitest run",
    "test:coverage": "bun --bun vitest run --coverage",
    "test:watch": "bun --bun vitest"
  },
  "keywords": [
    "react",
    "reveal",
    "swipe",
    "scroll",
    "list-row",
    "actions",
    "mobile"
  ],
  "author": "Present Day",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/present-day/reveal-row.git"
  },
  "bugs": {
    "url": "https://github.com/present-day/reveal-row/issues"
  },
  "homepage": "https://github.com/present-day/reveal-row#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-istanbul": "^5.0.1",
    "jsdom": "^30.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
